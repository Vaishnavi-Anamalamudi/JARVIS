KAFKA_RETRY_DELAY_SECONDS=30
KAFKA_MAX_ATTEMPTS=5
KAFKA_OUTBOX_BATCH_SIZE=100
KAFKA_OUTBOX_POLL_INTERVAL_MS=30000

